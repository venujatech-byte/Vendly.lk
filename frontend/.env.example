VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Flask API used during local development.
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Business Assistant speech-to-text provider:
# - ai: records high-quality audio and sends it to Groq Whisper through Flask.
# - browser: uses the browser's built-in SpeechRecognition service.
VITE_VOICE_AGENT=ai
