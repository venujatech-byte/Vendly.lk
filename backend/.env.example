# Flask
FLASK_DEBUG=true
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173

# Firebase Admin
# On Google Cloud, Application Default Credentials are used automatically.
# For local development, point this to a downloaded service-account JSON file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudinary media storage (free plan is sufficient for development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional chatbot AI. Leave AI_PROVIDER=none for deterministic catalogue chat.
# Supported: none, groq, openrouter, gemini, cerebras, openai-compatible
#
# Changing AI_PROVIDER is the whole switch: the endpoint, the timeout and the
# provider's quirks come with it. Set AI_API_KEY and AI_MODEL to match, and the
# rest adapts. Run `python scripts/compare_ai_providers.py` to try the ones you
# have keys for on the same questions before choosing.
#
# Verified models, at the time of writing - always check the provider's own
# list, they retire names without notice:
#   groq        AI_MODEL=openai/gpt-oss-120b   (fast, steady, 8k tokens/minute)
#   openrouter  AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   gemini      set AI_MODEL from Google AI Studio
#   cerebras    set AI_MODEL from the Cerebras catalogue
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Required only for openai-compatible; optional override for Groq/Cerebras.
AI_API_BASE_URL=
AI_TIMEOUT_SECONDS=15

# Business Assistant speech-to-text. This key is read by Flask only and must
# never be added to a VITE_* variable or committed to source control.
GROQ_API_KEY=
# Accuracy-first multilingual model. Use whisper-large-v3-turbo when lower
# cost and slightly faster transcription matter more than maximum accuracy.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=45

# A cheaper model for the mechanical calls - reading an intent, naming a
# language, translating a sentence the code already wrote. These run on EVERY
# message and are most of the token bill, but they need none of the reasoning
# the catalogue answers do. Leave blank to send everything to AI_MODEL.
#
# Opt-in on purpose: a model your account does not have is a 404 on every
# single message, so nothing is filled in here for you. Worth setting when the
# provider limits TOKENS per minute (Groq); pointless when it limits REQUESTS
# per day (OpenRouter free), where a smaller model saves nothing.
#   groq  AI_FAST_MODEL=openai/gpt-oss-20b
AI_FAST_MODEL=

# A second provider, tried when the first cannot answer: a rate limit, a 5xx,
# a timeout or a dropped connection. NOT for other 4xx errors - a wrong model
# name or a revoked key is a fault to fix, and answering it from elsewhere
# would hide it. The free tier runs
# out of tokens per minute several times a day, and every AI reply degrades to
# deterministic English when it does - this turns that ceiling into a slowdown.
# Leave AI_FALLBACK_API_KEY blank to keep the current behaviour.
# OpenRouter is OpenAI-compatible, so no other setting is needed; its free
# models carry a :free suffix, for example:
#   AI_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_BASE_URL=

# Use memory:// only for local development or a single backend process.
# Use a shared Redis storage URI before running multiple production instances.
RATE_LIMIT_STORAGE_URI=memory://

# PayHere Checkout API. Keep the merchant secret on Flask only.
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
FRONTEND_PUBLIC_URL=http://localhost:5173
# PayHere callbacks require a publicly reachable HTTPS URL; localhost works
# only for opening checkout, not for receiving the final payment notification.
BACKEND_PUBLIC_URL=http://127.0.0.1:5000
